{
  "name": "qrate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "framer-motion": "12.40.0",
    "lucide-react": "1.17.0",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "fast-check": "^3.22.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.6"
  }
}
